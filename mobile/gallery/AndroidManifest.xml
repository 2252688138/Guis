<?xml version="1.0" encoding="utf-8"?>
<!--
  GoGUI 组件演示（gallery）Android 清单 —— NativeActivity 模式，没有 Java 代码。

  - android:hasCode="true"：APK 里有 classes.dex——只包含输入法桥 ImeBridge
    （Java 源代码在 mobile/gallery/java，由 build-android-apk.ps1 用 javac + d8 编成 dex）。
    NativeActivity 没有 InputConnection，软键盘的中文上屏必须靠这个隐藏 EditText 承接，
    见 internal/android/ime.go + ui/ime_android.go。
  - meta-data android.app.lib_name=gallery：系统据此加载 lib/<abi>/libgallery.so
    并调用导出符号 ANativeActivity_onCreate（见 ui/main_entry_android.go 与 cmd/gallery/main.go）
  - android:extractNativeLibs="true"：允许 .so 压缩进 APK（安装时由系统解出），
    否则 .so 必须以 stored 方式写入并 4KB 对齐（zipalign -p）
  - 打包：./build-android-apk.ps1（aapt2 link → 加 so → zipalign → apksigner）
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gogui.gallery"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- 渲染器用 GLSL ES 300，OpenGL ES 3.0 是硬性要求（与 GoGUI 移动端示例一致） -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="GoGUI 组件演示"
        android:hasCode="true"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true">

        <activity
            android:name="com.gogui.gallery.GalleryActivity"
            android:label="GoGUI 组件演示"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize|smallestScreenSize|density|uiMode|navigation|layoutDirection|fontScale"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="gallery" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
